<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Removido Microsoft.AspNetCore.OpenApi para evitar conflito com Swashbuckle -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ViacaoCalango.Application\ViacaoCalango.Application.csproj" />
    <ProjectReference Include="..\ViacaoCalango.Infrastructure\ViacaoCalango.Infrastructure.csproj" />
  </ItemGroup>

</Project>


