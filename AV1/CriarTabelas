CREATE TABLE Clientes (cpf VARCHAR(20) PRIMARY KEY, nome VARCHAR(150), email VARCHAR(100), telefone VARCHAR(20));
CREATE TABLE Produtos (sku VARCHAR(50) PRIMARY KEY, nome VARCHAR(150), estoque_atual INT DEFAULT 0, qtd_reposicao INT DEFAULT 50);
CREATE TABLE Pedidos (order_id VARCHAR(50) PRIMARY KEY, cpf_cliente VARCHAR(20) REFERENCES Clientes(cpf), data_compra DATE, valor_total NUMERIC(10,2), status VARCHAR(20) DEFAULT 'Novo');
CREATE TABLE ItensPedido (id_item SERIAL PRIMARY KEY, order_id VARCHAR(50) REFERENCES Pedidos(order_id), order_item_id VARCHAR(50), sku VARCHAR(50) REFERENCES Produtos(sku), quantidade INT, preco_unitario NUMERIC(10,2));
CREATE TABLE MovimentacaoEstoque (id_movimentacao SERIAL PRIMARY KEY, order_id VARCHAR(50), sku VARCHAR(50), quantidade_retirada INT, saldo_apos_retirada INT, data_movimentacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP);
CREATE TABLE ComprasReposicao (id_compra SERIAL PRIMARY KEY, sku VARCHAR(50) REFERENCES Produtos(sku), quantidade_a_comprar INT, order_id_pendente VARCHAR(50), status VARCHAR(20) DEFAULT 'Aguardando Compra');
CREATE TABLE CargaTemporaria (order_id VARCHAR(50), order_item_id VARCHAR(50), purchase_date VARCHAR(50), payments_date VARCHAR(50), buyer_email VARCHAR(100), buyer_name VARCHAR(150), cpf VARCHAR(20), buyer_phone_number VARCHAR(20), sku VARCHAR(50), upc VARCHAR(50), product_name VARCHAR(150), quantity_purchased VARCHAR(20), currency VARCHAR(10), item_price VARCHAR(20), ship_service_level VARCHAR(50), ship_address_1 VARCHAR(200), ship_address_2 VARCHAR(200), ship_address_3 VARCHAR(200), ship_city VARCHAR(100), ship_state VARCHAR(50), ship_postal_code VARCHAR(20), ship_country VARCHAR(50));
CREATE TABLE CargaTemporaria_Estoque (sku VARCHAR(50), product_name VARCHAR(150), initial_stock VARCHAR(20), restock_amount VARCHAR(20));