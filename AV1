CREATE TABLE Clientes (
    cpf VARCHAR(20) PRIMARY KEY, nome VARCHAR(150), email VARCHAR(100), telefone VARCHAR(20)
);

CREATE TABLE Produtos (
    sku VARCHAR(50) PRIMARY KEY, nome VARCHAR(150), estoque_atual INT DEFAULT 0, qtd_reposicao INT DEFAULT 50
);

CREATE TABLE Pedidos (
    order_id VARCHAR(50) PRIMARY KEY, cpf_cliente VARCHAR(20) REFERENCES Clientes(cpf), data_compra DATE, valor_total NUMERIC(10,2), status VARCHAR(20) DEFAULT 'Novo'
);

CREATE TABLE ItensPedido (
    id_item SERIAL PRIMARY KEY, order_id VARCHAR(50) REFERENCES Pedidos(order_id), order_item_id VARCHAR(50), sku VARCHAR(50) REFERENCES Produtos(sku), quantidade INT, preco_unitario NUMERIC(10,2)
);

CREATE TABLE MovimentacaoEstoque (
    id_movimentacao SERIAL PRIMARY KEY, order_id VARCHAR(50), sku VARCHAR(50), quantidade_retirada INT, saldo_apos_retirada INT, data_movimentacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE ComprasReposicao (
    id_compra SERIAL PRIMARY KEY, sku VARCHAR(50) REFERENCES Produtos(sku), quantidade_a_comprar INT, order_id_pendente VARCHAR(50), status VARCHAR(20) DEFAULT 'Aguardando Compra'
);

CREATE TABLE CargaTemporaria (
    order_id VARCHAR(50), order_item_id VARCHAR(50), purchase_date VARCHAR(50), payments_date VARCHAR(50), buyer_email VARCHAR(100), buyer_name VARCHAR(150), cpf VARCHAR(20), buyer_phone_number VARCHAR(20), sku VARCHAR(50), upc VARCHAR(50), product_name VARCHAR(150), quantity_purchased VARCHAR(20), currency VARCHAR(10), item_price VARCHAR(20), ship_service_level VARCHAR(50), ship_address_1 VARCHAR(200), ship_address_2 VARCHAR(200), ship_address_3 VARCHAR(200), ship_city VARCHAR(100), ship_state VARCHAR(50), ship_postal_code VARCHAR(20), ship_country VARCHAR(50)
);

CREATE TABLE CargaTemporaria_Estoque (
    sku VARCHAR(50), product_name VARCHAR(150), initial_stock VARCHAR(20), restock_amount VARCHAR(20)
);


CREATE OR REPLACE PROCEDURE prc_etl_carga_pedidos()
LANGUAGE plpgsql
AS $$
BEGIN
    INSERT INTO Clientes (cpf, nome, email, telefone)
    SELECT DISTINCT cpf, buyer_name, buyer_email, buyer_phone_number
    FROM CargaTemporaria WHERE cpf IS NOT NULL ON CONFLICT (cpf) DO NOTHING;

    INSERT INTO Produtos (sku, nome, estoque_atual, qtd_reposicao)
    SELECT sku, product_name, initial_stock::INT, restock_amount::INT
    FROM CargaTemporaria_Estoque ON CONFLICT (sku) DO NOTHING;

    INSERT INTO Pedidos (order_id, cpf_cliente, data_compra, valor_total, status)
    SELECT order_id, MAX(cpf), TO_DATE(MAX(purchase_date), 'YYYY-MM-DD'), SUM(REPLACE(quantity_purchased, ',', '.')::INT * REPLACE(item_price, ',', '.')::NUMERIC), 'Novo'
    FROM CargaTemporaria GROUP BY order_id ON CONFLICT (order_id) DO NOTHING;

    INSERT INTO ItensPedido (order_id, order_item_id, sku, quantidade, preco_unitario)
    SELECT order_id, order_item_id, sku, REPLACE(quantity_purchased, ',', '.')::INT, REPLACE(item_price, ',', '.')::NUMERIC
    FROM CargaTemporaria;

    TRUNCATE TABLE CargaTemporaria, CargaTemporaria_Estoque;
END;
$$;


CREATE OR REPLACE PROCEDURE prc_processar_estoque_pedidos()
LANGUAGE plpgsql
AS $$
DECLARE
    v_order_id VARCHAR(50); v_valor_total NUMERIC; v_falta_estoque INT;
    v_sku VARCHAR(50); v_qtd_comprada INT; v_estoque_atual INT; v_qtd_reposicao INT; v_saldo_novo INT;

    cur_pedidos CURSOR FOR SELECT order_id, valor_total FROM Pedidos WHERE status = 'Novo' ORDER BY valor_total DESC;
    cur_itens REFCURSOR;
BEGIN
    OPEN cur_pedidos;
    LOOP
        FETCH cur_pedidos INTO v_order_id, v_valor_total;
        EXIT WHEN NOT FOUND;

        SELECT COUNT(*) INTO v_falta_estoque FROM ItensPedido ip JOIN Produtos p ON ip.sku = p.sku WHERE ip.order_id = v_order_id AND p.estoque_atual < ip.quantidade;

        IF v_falta_estoque = 0 THEN
            UPDATE Pedidos SET status = 'Atendido' WHERE order_id = v_order_id;
            
            OPEN cur_itens FOR SELECT sku, quantidade FROM ItensPedido WHERE order_id = v_order_id;
            LOOP
                FETCH cur_itens INTO v_sku, v_qtd_comprada;
                EXIT WHEN NOT FOUND;
                
                UPDATE Produtos SET estoque_atual = estoque_atual - v_qtd_comprada WHERE sku = v_sku RETURNING estoque_atual INTO v_saldo_novo;
                INSERT INTO MovimentacaoEstoque (order_id, sku, quantidade_retirada, saldo_apos_retirada) VALUES (v_order_id, v_sku, v_qtd_comprada, v_saldo_novo);
            END LOOP;
            CLOSE cur_itens;
        ELSE
            UPDATE Pedidos SET status = 'Pendente' WHERE order_id = v_order_id;
            
            OPEN cur_itens FOR SELECT ip.sku, ip.quantidade, p.estoque_atual, p.qtd_reposicao FROM ItensPedido ip JOIN Produtos p ON ip.sku = p.sku WHERE ip.order_id = v_order_id;
            LOOP
                FETCH cur_itens INTO v_sku, v_qtd_comprada, v_estoque_atual, v_qtd_reposicao;
                EXIT WHEN NOT FOUND;
                
                IF v_estoque_atual < v_qtd_comprada THEN
                    INSERT INTO ComprasReposicao (sku, quantidade_a_comprar, order_id_pendente) SELECT v_sku, v_qtd_reposicao, v_order_id WHERE NOT EXISTS (SELECT 1 FROM ComprasReposicao WHERE sku = v_sku AND status = 'Aguardando Compra');
                END IF;
            END LOOP;
            CLOSE cur_itens;
        END IF;
    END LOOP;
    CLOSE cur_pedidos;
END;
$$;

COPY CargaTemporaria FROM 'C:\temp\pedidos.csv' WITH (FORMAT CSV, DELIMITER ';', HEADER);
COPY CargaTemporaria_Estoque FROM 'C:\temp\estoque.csv' WITH (FORMAT CSV, DELIMITER ';', HEADER);

CALL prc_etl_carga_pedidos();
CALL prc_processar_estoque_pedidos();

SELECT order_id, valor_total, status FROM Pedidos ORDER BY valor_total DESC;
